PORT=3000
NODE_ENV=development

# MySQL: mysql://USUARIO:SENHA@HOST:PORTA/BANCO
DATABASE_URL="mysql://root:SUA_SENHA@localhost:3306/pro_crm"

JWT_SECRET="troque-por-uma-chave-longa-e-aleatoria"
JWT_EXPIRES_IN="24h"

# Login em duas etapas (código por e-mail). Use "false" para desligar.
OTP_ENABLED=true

# SMTP para envio do código. Sem SMTP, em desenvolvimento o código
# aparece no terminal do servidor.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Usuário master criado pelo seed (apenas desenvolvimento; troque em produção)
SEED_MASTER_EMAIL="master@procopio.local"
SEED_MASTER_PASSWORD="Trocar@123"

# Quantos proxies existem na frente da API (nginx = 1). Deixe 0 sem proxy:
# confiar em X-Forwarded-For sem proxy permite falsificar o IP (e burlar o controle por IP).
TRUST_PROXY=0

# Chave que cifra as chaves de API do assistente de IA no banco:
# 64 caracteres hexadecimais. Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ASSISTENTE_CHAVE=

# Emergência: "true" desliga a sessão única e o bloqueio por IP do master
CONTROLE_ACESSO_DESLIGADO=false

# Origens permitidas no CORS, separadas por vírgula
CORS_ORIGIN="http://localhost:5173"
