model CampanhaSupervisorCliente {
  id         String   @id @default(uuid()) @db.VarChar(36)
  donoId     String   @map("dono_id") @db.VarChar(36)
  campanhaId String   @map("campanha_id") @db.VarChar(36)
  leadId     String?  @map("lead_id") @db.VarChar(36)
  convenio   String
  cpf        String?
  matricula  String?
  criadoEm   DateTime @default(now()) @map("criado_em")

  campanha CampanhaSupervisor @relation(fields: [campanhaId], references: [id], onDelete: Cascade)

