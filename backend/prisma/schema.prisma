// Schema do PRO-CRM (MySQL). Sem tabelas de robôs de automação.
//
// Multi-equipe: todo registro de negócio tem `donoId`, o usuário (supervisor)
// dono dos dados. Promotores gravam com o donoId do seu supervisor.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum Perfil {
  MASTER
  GERENTE
  SUPERVISOR
  BKO
  PROMOTOR
}

enum TipoContato {
  PESSOA
  EMPRESA
}

enum StatusProjeto {
  EM_ANDAMENTO
  CONCLUIDO
  PAUSADO
  CANCELADO
}

enum StatusTarefa {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDA
}

enum PrioridadeNivel {
  BAIXA
  MEDIA
  ALTA
  URGENTE
}

enum StatusChamado {
  NOVO
  EM_ANDAMENTO
  AGUARDANDO
  RESOLVIDO
  FECHADO
}

enum SituacaoCampanha {
  RASCUNHO
  EM_FILA
  ENVIANDO
  ENVIADO
  CANCELADO
}

enum EstagioNota {
  NOVA
  ATA_REUNIAO
  ANOTACAO
  A_FAZER
}

enum StatusImportacao {
  PENDENTE
  IMPORTADO
  ERRO
}

enum ModoConversa {
  IA
  HUMANO
}

enum RemetenteWa {
  LEAD
  IA
  HUMANO
}

// ============================================================
// USUÁRIOS E ACESSO
// ============================================================

model Usuario {
  id           String    @id @default(uuid()) @db.VarChar(36)
  perfil       Perfil
  nome         String
  email        String    @unique
  senhaHash    String    @map("senha_hash")
  cargo        String?
  departamento String?
  telefone     String?
  // Foto de perfil como imagem pequena em texto (data URL), já reduzida pelo navegador
  fotoUrl      String?   @map("foto_url") @db.MediumText
  ativo        Boolean   @default(true)
  ultimoLogin  DateTime? @map("ultimo_login")

  // Hierarquia: promotor -> supervisor -> master
  superiorId String?   @map("superior_id") @db.VarChar(36)
  superior   Usuario?  @relation("Hierarquia", fields: [superiorId], references: [id], onDelete: SetNull)
  subordinados Usuario[] @relation("Hierarquia")

  // Permissões
  permissoes          Json    @default("[]")
  permissaoEstrategia Boolean @default(true) @map("permissao_estrategia")
  permissaoImportacao Boolean @default(false) @map("permissao_importacao")
  // Gerente: ids dos supervisores sob sua gestão
  supervisoresGerenciados Json @default("[]") @map("supervisores_gerenciados")

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  mensagensEnviadas Mensagem[]

  @@index([superiorId])
  @@index([perfil])
  @@map("usuarios")
}

// Código temporário (OTP) para o login em duas etapas
model LoginOtp {
  id         String   @id @default(uuid()) @db.VarChar(36)
  usuarioId  String   @map("usuario_id") @db.VarChar(36)
  email      String
  codigoHash String   @map("codigo_hash")
  expiraEm   DateTime @map("expira_em")
  usado      Boolean  @default(false)
  tentativas Int      @default(0)
  criadoEm   DateTime @default(now()) @map("criado_em")

  @@index([email])
  @@index([usuarioId])
  @@map("login_otps")
}

// Sessão única e IPs liberados por usuário
model ControleAcesso {
  usuarioId           String    @id @map("usuario_id") @db.VarChar(36)
  sessaoId            String?   @map("sessao_id")
  ips                 Json      @default("[]")
  ultimoIp            String?   @map("ultimo_ip")
  ultimoAcessoEm      DateTime? @map("ultimo_acesso_em")
  ipBloqueado         String?   @map("ip_bloqueado")
  ipBloqueadoEm       DateTime? @map("ip_bloqueado_em")
  travarPrimeiroLogin Boolean   @default(false) @map("travar_primeiro_login")
  atualizadoEm        DateTime  @default(now()) @updatedAt @map("atualizado_em")

  @@map("controle_acesso")
}

// ============================================================
// CRM
// ============================================================

model Contato {
  id          String      @id @default(uuid()) @db.VarChar(36)
  donoId      String      @map("dono_id") @db.VarChar(36)
  nome        String
  empresa     String?
  pais        String?     @default("Brasil")
  telefone    String?
  email       String?
  tipo        TipoContato @default(PESSOA)
  favorito    Boolean     @default(false)
  fotoUrl     String?     @map("foto_url")
  observacoes String?     @db.Text
  criadoEm    DateTime    @default(now()) @map("criado_em")
  atualizadoEm DateTime   @updatedAt @map("atualizado_em")

  oportunidades Oportunidade[]

  @@index([donoId])
  @@index([donoId, nome])
  @@map("contatos")
}

model Oportunidade {
  id           String    @id @default(uuid()) @db.VarChar(36)
  donoId       String    @map("dono_id") @db.VarChar(36)
  contatoId    String?   @map("contato_id") @db.VarChar(36)
  responsavelId String?  @map("responsavel_id") @db.VarChar(36)
  nome         String
  empresa      String?
  valor        Decimal?  @db.Decimal(15, 2)
  // novo | contactando | segundo_dia | terceiro_dia | proposta | ganhamos | perdemos
  estagio      String    @default("novo")
  pipeline     String    @default("Meu Pipeline")
  dataPrevista DateTime? @map("data_prevista") @db.Date
  prioridade   Int       @default(0) // 0 a 3 estrelas
  descricao    String?   @db.Text
  telefone     String?
  email        String?
  produto      String?
  cidade       String?
  cpf          String?
  motivoPerda  String?   @map("motivo_perda")
  // Data da última mudança de estágio (expiração conta a partir daqui)
  estagioAtualizadoEm DateTime? @map("estagio_atualizado_em")
  // Campos extras: celulares, nascimento, matrícula, margens etc.
  detalhes     Json?
  // Negociação
  receitaEsperada Decimal?  @map("receita_esperada") @db.Decimal(15, 2)
  dataRetorno     DateTime? @map("data_retorno") @db.Date
  horaRetorno     String?   @map("hora_retorno") @db.VarChar(5)
  // Histórico de atividades (gerado pelo servidor): [{ data, usuario, estagio?, alteracoes?, notaInterna? }]
  atividades      Json?
  criadoEm     DateTime  @default(now()) @map("criado_em")
  atualizadoEm DateTime  @updatedAt @map("atualizado_em")

  contato Contato? @relation(fields: [contatoId], references: [id], onDelete: SetNull)

  @@index([donoId])
  @@index([donoId, estagio])
  @@index([donoId, pipeline])
  @@index([responsavelId])
  @@index([donoId, dataRetorno])
  @@map("oportunidades")
}

model Produto {
  id        String   @id @default(uuid()) @db.VarChar(36)
  donoId    String   @map("dono_id") @db.VarChar(36)
  nome      String
  origem    String?
  ddd       String?
  telefone  String?
  qtdOutrosProdutos Int?    @map("qtd_outros_produtos")
  outrosProdutos    String? @map("outros_produtos") @db.Text
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@index([donoId])
  @@index([donoId, origem])
  @@map("produtos")
}

model Projeto {
  id          String        @id @default(uuid()) @db.VarChar(36)
  donoId      String        @map("dono_id") @db.VarChar(36)
  nome        String
  responsavel String?
  dataInicio  DateTime?     @map("data_inicio") @db.Date
  dataFim     DateTime?     @map("data_fim") @db.Date
  equipe      String?
  descricao   String?       @db.Text
  status      StatusProjeto @default(EM_ANDAMENTO)
  progresso   Int           @default(0)
  prioridade  PrioridadeNivel @default(MEDIA)
  categoria   String?
  favorito    Boolean       @default(false)
  criadoEm     DateTime     @default(now()) @map("criado_em")
  atualizadoEm DateTime     @updatedAt @map("atualizado_em")

  tarefas Tarefa[]

  @@index([donoId])
  @@index([donoId, status])
  @@map("projetos")
}

model Tarefa {
  id          String       @id @default(uuid()) @db.VarChar(36)
  projetoId   String       @map("projeto_id") @db.VarChar(36)
  titulo      String
  descricao   String?      @db.Text
  status      StatusTarefa @default(PENDENTE)
  responsavel String?
  dataLimite  DateTime?    @map("data_limite") @db.Date
  ordem       Int          @default(0)
  criadoEm     DateTime    @default(now()) @map("criado_em")
  atualizadoEm DateTime    @updatedAt @map("atualizado_em")

  projeto Projeto @relation(fields: [projetoId], references: [id], onDelete: Cascade)

  @@index([projetoId])
  @@map("tarefas")
}

model Observacao {
  id       String      @id @default(uuid()) @db.VarChar(36)
  donoId   String      @map("dono_id") @db.VarChar(36)
  titulo   String
  conteudo String?     @db.Text
  estagio  EstagioNota @default(ANOTACAO)
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@index([donoId])
  @@map("observacoes")
}

model EventoCalendario {
  id          String   @id @default(uuid()) @db.VarChar(36)
  donoId      String   @map("dono_id") @db.VarChar(36)
  titulo      String
  descricao   String?  @db.Text
  dataInicio  DateTime @map("data_inicio")
  dataFim     DateTime @map("data_fim")
  diaInteiro  Boolean  @default(false) @map("dia_inteiro")
  cor         String   @default("indigo")
  local       String?
  participante String?
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@index([donoId])
  @@index([donoId, dataInicio, dataFim])
  @@map("eventos_calendario")
}

// ============================================================
// MENSAGENS INTERNAS (INBOX)
// ============================================================

model Canal {
  id        String   @id @default(uuid()) @db.VarChar(36)
  donoId    String   @map("dono_id") @db.VarChar(36)
  nome      String
  descricao String?
  criadoEm  DateTime @default(now()) @map("criado_em")

  mensagens Mensagem[]

  @@unique([donoId, nome])
  @@index([donoId])
  @@map("canais")
}

model Mensagem {
  id          String          @id @default(uuid()) @db.VarChar(36)
  canalId     String          @map("canal_id") @db.VarChar(36)
  remetenteId String?         @map("remetente_id") @db.VarChar(36)
  conteudo    String          @db.Text
  lida        Boolean         @default(false)
  favorita    Boolean         @default(false)
  prioridade  PrioridadeNivel @default(MEDIA)
  criadoEm    DateTime        @default(now()) @map("criado_em")

  canal     Canal    @relation(fields: [canalId], references: [id], onDelete: Cascade)
  remetente Usuario? @relation(fields: [remetenteId], references: [id], onDelete: SetNull)

  @@index([canalId])
  @@index([canalId, lida])
  @@map("mensagens")
}

model Notificacao {
  id        String   @id @default(uuid()) @db.VarChar(36)
  donoId    String   @map("dono_id") @db.VarChar(36)
  usuarioId String?  @map("usuario_id") @db.VarChar(36)
  tipo      String
  titulo    String
  mensagem  String?  @db.Text
  lida      Boolean  @default(false)
  criadoEm  DateTime @default(now()) @map("criado_em")

  @@index([donoId, lida])
  @@index([usuarioId])
  @@map("notificacoes")
}

// ============================================================
// MARKETING
// ============================================================

model EmailMarketing {
  id             String           @id @default(uuid()) @db.VarChar(36)
  donoId         String           @map("dono_id") @db.VarChar(36)
  assunto        String
  responsavel    String?
  listaCorreio   String?          @map("lista_correio")
  enviados       Int              @default(0)
  entreguePct    Decimal?         @map("entregue_pct") @db.Decimal(5, 2)
  abertoPct      Decimal?         @map("aberto_pct") @db.Decimal(5, 2)
  clicadoPct     Decimal?         @map("clicado_pct") @db.Decimal(5, 2)
  respondidoPct  Decimal?         @map("respondido_pct") @db.Decimal(5, 2)
  situacao       SituacaoCampanha @default(RASCUNHO)
  dataEnvio      DateTime?        @map("data_envio")
  criadoEm       DateTime         @default(now()) @map("criado_em")
  atualizadoEm   DateTime         @updatedAt @map("atualizado_em")

  @@index([donoId])
  @@index([donoId, situacao])
  @@map("email_marketing")
}

model SmsMarketing {
  id             String           @id @default(uuid()) @db.VarChar(36)
  donoId         String           @map("dono_id") @db.VarChar(36)
  nome           String
  listaCorreio   String?          @map("lista_correio")
  enviados       Int              @default(0)
  entregues      Int              @default(0)
  abertoPct      Decimal?         @map("aberto_pct") @db.Decimal(5, 2)
  respondidoPct  Decimal?         @map("respondido_pct") @db.Decimal(5, 2)
  clicadoPct     Decimal?         @map("clicado_pct") @db.Decimal(5, 2)
  situacao       SituacaoCampanha @default(RASCUNHO)
  dataInicio     DateTime?        @map("data_inicio") @db.Date
  dataFim        DateTime?        @map("data_fim") @db.Date
  criadoEm       DateTime         @default(now()) @map("criado_em")
  atualizadoEm   DateTime         @updatedAt @map("atualizado_em")

  @@index([donoId])
  @@index([donoId, situacao])
  @@map("sms_marketing")
}

// ============================================================
// CENTRAL DE AJUDA
// ============================================================

model TimeAjuda {
  id           String   @id @default(uuid()) @db.VarChar(36)
  donoId       String   @map("dono_id") @db.VarChar(36)
  nome         String
  naoAtribuidos Int     @default(0) @map("nao_atribuidos")
  naoAtendidos  Int     @default(0) @map("nao_atendidos")
  prioridade   Int      @default(0)
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  chamados Chamado[]

  @@index([donoId])
  @@map("times_ajuda")
}

model Chamado {
  id           String          @id @default(uuid()) @db.VarChar(36)
  donoId       String          @map("dono_id") @db.VarChar(36)
  timeId       String?         @map("time_id") @db.VarChar(36)
  atribuidoAId String?         @map("atribuido_a_id") @db.VarChar(36)
  titulo       String
  descricao    String?         @db.Text
  status       StatusChamado   @default(NOVO)
  prioridade   PrioridadeNivel @default(MEDIA)
  criadoEm     DateTime        @default(now()) @map("criado_em")
  atualizadoEm DateTime        @updatedAt @map("atualizado_em")

  time TimeAjuda? @relation(fields: [timeId], references: [id], onDelete: SetNull)

  @@index([donoId])
  @@index([donoId, status])
  @@map("chamados")
}

// ============================================================
// CRÉDITO: CONVÊNIOS, MARGEM, SIMULAÇÕES, DÍVIDAS
// ============================================================

model Convenio {
  id        String   @id @default(uuid()) @db.VarChar(36)
  donoId    String   @map("dono_id") @db.VarChar(36)
  nome      String
  descricao String?  @db.Text
  ativo     Boolean  @default(true)
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@index([donoId])
  @@map("convenios")
}

// Convênios cadastrados e leads duplicados usam a mesma estrutura,
// distinguidos por `tipo`: CADASTRADO | LEAD_DUPLICADO
model ConvenioControle {
  id            String   @id @default(uuid()) @db.VarChar(36)
  donoId        String   @map("dono_id") @db.VarChar(36)
  tipo          String   @default("CADASTRADO")
  empregador    String
  codigo        String?
  tipoMargem    String?  @map("tipo_margem")
  funcionarios  Int      @default(0)
  naoReservados Int      @default(0) @map("nao_reservados")
  reservados    Int      @default(0)
  perdidos      Int      @default(0)
  criadoEm      DateTime @default(now()) @map("criado_em")
  atualizadoEm  DateTime @updatedAt @map("atualizado_em")

  @@index([donoId, tipo])
  @@map("convenios_controle")
}

model ConvenioCompleto {
  id        String   @id @default(uuid()) @db.VarChar(36)
  donoId    String   @map("dono_id") @db.VarChar(36)
  nome      String
  cnpj      String?
  codigo    String?
  detalhes  Json?
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@index([donoId])
  @@map("convenios_completos")
}

model Inconsistencia {
  id             String    @id @default(uuid()) @db.VarChar(36)
  donoId         String    @map("dono_id") @db.VarChar(36)
  parceiro       String
  codigoConvenio String    @map("codigo_convenio")
  resolvido      Boolean   @default(false)
  dataRegistro   DateTime? @map("data_registro")
  observacao     String?   @db.Text
  criadoEm       DateTime  @default(now()) @map("criado_em")
  atualizadoEm   DateTime  @updatedAt @map("atualizado_em")

  @@index([donoId])
  @@index([donoId, resolvido])
  @@map("inconsistencias")
}

model MargemConsignado {
  id            String   @id @default(uuid()) @db.VarChar(36)
  donoId        String   @map("dono_id") @db.VarChar(36)
  origem        String?
  nome          String
  ddd           String?
  telefone      String?
  margemLivre   Decimal? @map("margem_livre") @db.Decimal(15, 2)
  status        String?
  observacao    String?  @db.Text
  mensagemBanco String?  @map("mensagem_banco") @db.Text
  tags          Json     @default("[]")
  criadoEm      DateTime @default(now()) @map("criado_em")
  atualizadoEm  DateTime @updatedAt @map("atualizado_em")

  @@index([donoId])
  @@index([donoId, origem])
  @@map("margens_consignado")
}

model MargemSolicitacao {
  id          String   @id @default(uuid()) @db.VarChar(36)
  donoId      String   @map("dono_id") @db.VarChar(36)
  nome        String?
  cpf         String?
  telefone    String?
  margemLivre Decimal? @map("margem_livre") @db.Decimal(15, 2)
  status      String   @default("pendente")
  observacao  String?  @db.Text
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@index([donoId])
  @@map("margens_solicitacao")
}

model Simulacao {
  id            String   @id @default(uuid()) @db.VarChar(36)
  donoId        String   @map("dono_id") @db.VarChar(36)
  convenio      String?
  codEmpresa    String?  @map("cod_empresa")
  cpf           String?
  cpfCliente    String?  @map("cpf_cliente")
  margemLivre   Decimal? @map("margem_livre") @db.Decimal(15, 2)
  nome          String?
  ddd           String?
  telefone      String?
  status        String?
  observacao    String?  @db.Text
  qtdContratosRefin Int? @map("qtd_contratos_refin")
  contratosRefin    String? @map("contratos_refin") @db.Text
  criadoEm      DateTime @default(now()) @map("criado_em")
  atualizadoEm  DateTime @updatedAt @map("atualizado_em")

  @@index([donoId])
  @@index([donoId, status])
  @@map("simulacoes")
}

model Divida {
  id                String   @id @default(uuid()) @db.VarChar(36)
  donoId            String   @map("dono_id") @db.VarChar(36)
  empregador        String
  dividaTotal       Decimal? @map("divida_total") @db.Decimal(15, 2)
  taxaSimulacao     Decimal? @map("taxa_simulacao") @db.Decimal(10, 4)
  saldoClean        Decimal? @map("saldo_clean") @db.Decimal(15, 2)
  cartaoCredito     Decimal? @map("cartao_credito") @db.Decimal(15, 2)
  creditoPessoal    Decimal? @map("credito_pessoal") @db.Decimal(15, 2)
  creditoConsignado Decimal? @map("credito_consignado") @db.Decimal(15, 2)
  atraso            Decimal? @db.Decimal(15, 2)
  limiteEmConta     Decimal? @map("limite_em_conta") @db.Decimal(15, 2)
  criadoEm          DateTime @default(now()) @map("criado_em")
  atualizadoEm      DateTime @updatedAt @map("atualizado_em")

  @@index([donoId])
  @@map("dividas")
}

// Carteira de clientes (sem dados de automação)
model ClienteCarteira {
  id         String   @id @default(uuid()) @db.VarChar(36)
  donoId     String   @map("dono_id") @db.VarChar(36)
  cpf        String
  cpfCliente String?  @map("cpf_cliente")
  convenio   String?
  codEmpresa String?  @map("cod_empresa")
  nome       String?
  telefone   String?
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@index([donoId])
  @@index([donoId, cpf])
  @@map("clientes_carteira")
}

// ============================================================
// IMPORTAÇÃO DE PLANILHAS E LEADS
// ============================================================

model ImportacaoPlanilha {
  id             String           @id @default(uuid()) @db.VarChar(36)
  donoId         String           @map("dono_id") @db.VarChar(36)
  arquivo        String
  totalLinhas    Int              @default(0) @map("total_linhas")
  status         StatusImportacao @default(PENDENTE)
  origem         String?
  convenio       String?
  codConvenio    String?          @map("cod_convenio")
  duplicados     Int              @default(0)
  criadorId      String?          @map("criador_id") @db.VarChar(36)
  dataImportacao DateTime?        @map("data_importacao")
  criadoEm       DateTime         @default(now()) @map("criado_em")
  atualizadoEm   DateTime         @updatedAt @map("atualizado_em")

  leads LeadImportado[]

  @@index([donoId])
  @@map("importacoes_planilha")
}

model LeadImportado {
  id             String   @id @default(uuid()) @db.VarChar(36)
  donoId         String?  @map("dono_id") @db.VarChar(36)
  importacaoId   String?  @map("importacao_id") @db.VarChar(36)
  funcionarioId  String?  @map("funcionario_id") @db.VarChar(36)
  cpf            String?
  nome           String?
  telefone       String?
  matricula      String?
  convenio       String?
  codConvenio    String?  @map("cod_convenio")
  margem         String?
  // Margem livre em número (calculada de `margem` na importação), para filtrar por faixa
  margemValor    Decimal? @map("margem_valor") @db.Decimal(15, 2)
  margemMenor    String?  @map("margem_menor")
  statusLead     String   @default("novo") @map("status_lead")
  observacao     String?  @db.Text
  qtdContratos   String?  @map("qtd_contratos")
  contratos      String?  @db.Text
  qtdOutrosProdutos String? @map("qtd_outros_produtos")
  outrosProdutos    String? @map("outros_produtos") @db.Text
  origem         String?
  // Demais campos mapeados da planilha (nascimento, e-mail, margens, contrato...)
  dados          Json?
  criadoEm       DateTime @default(now()) @map("criado_em")
  atualizadoEm   DateTime @updatedAt @map("atualizado_em")

  importacao ImportacaoPlanilha? @relation(fields: [importacaoId], references: [id], onDelete: Cascade)

  @@index([donoId])
  @@index([importacaoId])
  @@index([funcionarioId])
  @@index([donoId, cpf, codConvenio])
  @@map("leads_importados")
}

model LeadSupervisor {
