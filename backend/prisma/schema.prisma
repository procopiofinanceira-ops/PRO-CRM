// ============================================================
// WHATSAPP (DISPAROS E ATENDIMENTO COM IA)
// ============================================================

model WaLead {
  id       String   @id @default(uuid()) @db.VarChar(36)
  donoId   String   @map("dono_id") @db.VarChar(36)
  telefone String
  nome     String?
  // novo | interesse | agendado | sem_interesse
  status   String   @default("novo")
  origem   String   @default("disparo")
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  conversa WaConversa?

  @@unique([donoId, telefone])
  @@map("wa_leads")
}

model WaConversa {
  id             String       @id @default(uuid()) @db.VarChar(36)
  donoId         String       @map("dono_id") @db.VarChar(36)
  leadId         String       @unique @map("lead_id") @db.VarChar(36)
  modo           ModoConversa @default(IA)
  aberta         Boolean      @default(true)
  precisaAtencao Boolean      @default(false) @map("precisa_atencao")
  motivoAtencao  String?      @map("motivo_atencao")
  ultimaMsgEm    DateTime?    @map("ultima_msg_em")
  criadoEm       DateTime     @default(now()) @map("criado_em")
  atualizadoEm   DateTime     @updatedAt @map("atualizado_em")

  lead      WaLead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  mensagens WaMensagem[]

  @@index([donoId])
  @@map("wa_conversas")
}

model WaMensagem {
  id         String      @id @default(uuid()) @db.VarChar(36)
  conversaId String      @map("conversa_id") @db.VarChar(36)
  remetente  RemetenteWa
  conteudo   String      @db.Text
  intencao   String?
  enviadaEm  DateTime    @default(now()) @map("enviada_em")

  conversa WaConversa @relation(fields: [conversaId], references: [id], onDelete: Cascade)

  @@index([conversaId])
  @@map("wa_mensagens")
}

model WaConhecimento {
  id       String   @id @default(uuid()) @db.VarChar(36)
  donoId   String   @map("dono_id") @db.VarChar(36)
  titulo   String
  conteudo String   @db.Text
  ativo    Boolean  @default(true)
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@index([donoId])
  @@map("wa_conhecimento")
}

model WaAgenteConfig {
  id          String   @id @default(uuid()) @db.VarChar(36)
  donoId      String   @unique @map("dono_id") @db.VarChar(36)
  nomeAgente  String   @default("Ana") @map("nome_agente")
  saudacao    String   @default("Oi, tudo bem? Posso te passar uma informação rápida que pode te ajudar?") @db.VarChar(500)
  promptExtra String?  @map("prompt_extra") @db.Text
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@map("wa_agente_config")
}

// ============================================================
// IMOBILIÁRIO
// ============================================================

model ImobProposta {
  id           String    @id @default(uuid()) @db.VarChar(36)
  donoId       String    @map("dono_id") @db.VarChar(36)
  criadorId    String?   @map("criador_id") @db.VarChar(36)
  parceiro     String?
  consultor    String?
  dataInicio   DateTime? @map("data_inicio")
  portal       String?
  proposta     String?
  aprovacao    String?
  agendamento  DateTime?
  documento    String?
  modalidade   String?
  produto      String?
  acao         String?
  etapa        String    @default("Proposta criada")
  etapaAtualizadaEm DateTime? @map("etapa_atualizada_em")
  observacao1  String?   @db.Text
  observacao2  String?   @db.Text

  // Cliente
  cliente        String?
  cpf            String?
  contato        String?
  emailCliente   String?   @map("email_cliente")
  dataNascimento DateTime? @map("data_nascimento")
  cidade         String?
  habitantes     String?
  situacaoProfissional String? @map("situacao_profissional")
  estadoCivil    String?   @map("estado_civil")

  // Renda
  rendaPrincipal String?  @map("renda_principal")
  rendaMensal    Decimal? @map("renda_mensal") @db.Decimal(15, 2)
  rendaFamiliar  Decimal? @map("renda_familiar") @db.Decimal(15, 2)

  // Cônjuge
  conjugeNome       String?   @map("conjuge_nome")
  conjugeEmail      String?   @map("conjuge_email")
  conjugeCelular    String?   @map("conjuge_celular")
  conjugeCpf        String?   @map("conjuge_cpf")
  conjugeNascimento DateTime? @map("conjuge_nascimento")
  conjugeRenda      Decimal?  @map("conjuge_renda") @db.Decimal(15, 2)

  // Crédito pretendido
  valorImovel           Decimal? @map("valor_imovel") @db.Decimal(15, 2)
  valorFinanciamentoLiq Decimal? @map("valor_financiamento_liq") @db.Decimal(15, 2)
  valorNecessario       Decimal? @map("valor_necessario") @db.Decimal(15, 2)
  prazoPretendido       String?  @map("prazo_pretendido")
  analiseCreditoStatus  String?  @map("analise_credito_status")

  // Imóvel em garantia
  numeroImovel       String? @map("numero_imovel")
  cepImovel          String? @map("cep_imovel")
  complementoImovel  String? @map("complemento_imovel")
  tipoImovelGarantia String? @map("tipo_imovel_garantia")
  pagandoImovel      String? @map("pagando_imovel")
  matriculaImovel    String? @map("matricula_imovel")

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  bancos     ImobPropostaBanco[]
  documentos ImobDocumento[]

  @@index([donoId])
  @@index([criadorId])
  @@map("imob_propostas")
}

// Um registro por banco consultado na proposta
// (Itaú, Santander, Bari, Credita, Cashme, Ponte, Tcash, Inter, Bradesco, C6, Daycoval...)
model ImobPropostaBanco {
  id            String   @id @default(uuid()) @db.VarChar(36)
  propostaId    String   @map("proposta_id") @db.VarChar(36)
  banco         String
  status        String?
  valorAprovado Decimal? @map("valor_aprovado") @db.Decimal(15, 2)
  criadoEm      DateTime @default(now()) @map("criado_em")
  atualizadoEm  DateTime @updatedAt @map("atualizado_em")

  proposta ImobProposta @relation(fields: [propostaId], references: [id], onDelete: Cascade)

  @@unique([propostaId, banco])
  @@map("imob_proposta_bancos")
}

model ImobDocumento {
  id           String   @id @default(uuid()) @db.VarChar(36)
  propostaId   String   @map("proposta_id") @db.VarChar(36)
  donoId       String   @map("dono_id") @db.VarChar(36)
  nome         String
  nomeOriginal String   @map("nome_original")
  mimeType     String?  @map("mime_type")
  tamanho      Int?
  caminho      String
  criadoEm     DateTime @default(now()) @map("criado_em")

  proposta ImobProposta @relation(fields: [propostaId], references: [id], onDelete: Cascade)

  @@index([propostaId])
  @@map("imob_documentos")
}

model ImobSimulacao {
  id          String   @id @default(uuid()) @db.VarChar(36)
  donoId      String   @map("dono_id") @db.VarChar(36)
  tipo        String
  criadorNome String?  @map("criador_nome")
  dados       Json
  resultado   Json
  criadoEm    DateTime @default(now()) @map("criado_em")

  @@index([donoId])
  @@map("imob_simulacoes")
}

// ============================================================
// INTEGRAÇÕES
// ============================================================

model IntegracaoUsuario {
  id           String   @id @default(uuid()) @db.VarChar(36)
  donoId       String   @map("dono_id") @db.VarChar(36)
  nome         String?
  tipo         String?
  configuracao Json
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@index([donoId])
  @@map("integracoes_usuario")
}

// ============================================================
// ASSISTENTE DE IA (configuração única do sistema, só o master altera)
// ============================================================

model ConfigAssistente {
  id                String   @id @default("padrao") @db.VarChar(20)
  provedor          String   @default("anthropic")
  ativo             Boolean  @default(true)
  instrucoesExtras  String?  @map("instrucoes_extras") @db.Text
  // Por provedor: { chaveCifrada, final, modelo }. A chave nunca volta para o navegador.
  provedores        Json
  atualizadoPorId   String?  @map("atualizado_por_id") @db.VarChar(36)
  atualizadoEm      DateTime @updatedAt @map("atualizado_em")

  @@map("config_assistente")
}
